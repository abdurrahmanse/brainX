{
  "name": "brainx",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm dev:stop && turbo run dev",
    "dev:stop": "for port in 3000 3001; do pids=$(lsof -ti tcp:$port -sTCP:LISTEN); [ -z \"$pids\" ] || kill $pids; done",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "boundaries": "turbo boundaries"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
